# Copy to .env.ui. Keep .env.ui private: the secret decrypts the camera URLs in SQLite.

# Absolute path of this checkout on the Jetson (output of `pwd` in this directory).
MODA_PROJECT_DIR=/home/jetson/moda-jetson

# Fernet key. Generate once with:
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Losing it means every camera URL has to be entered again.
MODA_CONFIG_SECRET=

# Listen address/port of the web UI. Prefer the Jetson's LAN IP over 0.0.0.0.
MODA_UI_BIND=0.0.0.0
MODA_UI_PORT=8080

# Seconds to watch recreated containers before declaring an apply successful.
MODA_UI_HEALTH_WAIT_SECONDS=20
