x-logging: &default-logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

x-analysis: &analysis
  image: ${MODA_ANALYSIS_IMAGE:-moda-analysis:jetpack6}
  build:
    context: .
    dockerfile: Dockerfile.analysis
    args:
      ANALYSIS_BASE_IMAGE: ${MODA_ANALYSIS_BASE_IMAGE:-ultralytics/ultralytics:8.3.153-jetson-jetpack6}
  restart: unless-stopped
  init: true
  runtime: nvidia
  ipc: host
  working_dir: /app
  entrypoint: ["python3", "-m", "post_analysis"]
  stop_grace_period: 30s
  logging: *default-logging
  environment:
    MODA_KAFKA_BOOTSTRAP_SERVERS: ${MODA_KAFKA_BOOTSTRAP_SERVERS:?set MODA_KAFKA_BOOTSTRAP_SERVERS}
    MODA_TRITON_URL: ${MODA_TRITON_URL:-http://triton:8000}
  volumes:
    - ./config/post_analysis.json:/app/config/post_analysis.json:ro
    - ./runtime:/workspace/traffic

services:
  triton:
    image: ${MODA_TRITON_IMAGE:-nvcr.io/nvidia/tritonserver:24.01-py3-igpu}
    restart: unless-stopped
    runtime: nvidia
    logging: *default-logging
    command: ["tritonserver", "--model-repository=/models"]
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/v2/health/ready', timeout=2).read()"]
      interval: 5s
      timeout: 3s
      retries: 30
      start_period: 20s
    expose:
      - "8000"
      - "8001"
      - "8002"
    volumes:
      - ./models/triton:/models:ro

  weight_reader:
    <<: *analysis
    command: ["weight", "--config", "/app/config/post_analysis.json"]
    depends_on:
      triton:
        condition: service_healthy
    environment:
      MODA_KAFKA_BOOTSTRAP_SERVERS: ${MODA_KAFKA_BOOTSTRAP_SERVERS:?set MODA_KAFKA_BOOTSTRAP_SERVERS}
      MODA_TRITON_URL: ${MODA_TRITON_URL:-http://triton:8000}
      MODA_WEIGHT_CAMERA_URL: ${MODA_WEIGHT_CAMERA_URL:?set MODA_WEIGHT_CAMERA_URL}

  cargo_recognition:
    <<: *analysis
    command: ["cargo", "--config", "/app/config/post_analysis.json"]
    depends_on:
      triton:
        condition: service_healthy
    environment:
      MODA_KAFKA_BOOTSTRAP_SERVERS: ${MODA_KAFKA_BOOTSTRAP_SERVERS:?set MODA_KAFKA_BOOTSTRAP_SERVERS}
      MODA_TRITON_URL: ${MODA_TRITON_URL:-http://triton:8000}
      MODA_CARGO_LAND1_CAMERA_URL: ${MODA_CARGO_LAND1_CAMERA_URL:?set MODA_CARGO_LAND1_CAMERA_URL}
      MODA_CARGO_LAND2_CAMERA_URL: ${MODA_CARGO_LAND2_CAMERA_URL:?set MODA_CARGO_LAND2_CAMERA_URL}
