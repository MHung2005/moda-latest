# Copy this file to .env.jetson and replace every camera/Kafka placeholder.
# Keep .env.jetson private because it contains camera credentials.
COMPOSE_PROJECT_NAME=moda-analysis

# The official Ultralytics JetPack 6 image supplies Python, PyTorch, OpenCV and
# Ultralytics. Pin the image digest here after validating it on the target device.
MODA_ANALYSIS_BASE_IMAGE=ultralytics/ultralytics:8.3.153-jetson-jetpack6
MODA_ANALYSIS_IMAGE=moda-analysis:jetpack6
MODA_TRITON_IMAGE=nvcr.io/nvidia/tritonserver:24.01-py3-igpu

MODA_KAFKA_BOOTSTRAP_SERVERS=192.168.1.10:29092
MODA_TRITON_URL=http://triton:8000

MODA_WEIGHT_CAMERA_URL=rtsp://user:password@weight-camera-host:port
MODA_CARGO_LAND1_CAMERA_URL=rtsp://user:password@cargo-camera-land1:port
MODA_CARGO_LAND2_CAMERA_URL=rtsp://user:password@cargo-camera-land2:port
